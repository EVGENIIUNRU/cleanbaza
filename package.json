{
  "name": "baza-clean-ops",
  "version": "1.0.0",
  "description": "Desktop checklist app for BAZA computer club cleanliness shifts.",
  "author": "BAZA by IGNATIEV",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:windows": "npm run build:win"
  },
  "devDependencies": {
    "electron": "^40.4.0",
    "electron-builder": "^26.4.0"
  },
  "build": {
    "appId": "ru.baza.cleanops",
    "productName": "BAZA Clean Ops",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "apps-script.gs",
      "shablon_chistoty_kompyuternogo_kluba.xlsx",
      "assets/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "assets/baza-app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BAZA Clean Ops"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
